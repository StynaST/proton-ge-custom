From 8deb9e41f975ea606c6d8796e7be23825a1439f6 Mon Sep 17 00:00:00 2001
From: Stella Reine <stella@styna.net>
Date: Fri, 16 Oct 2026 20:57:30 -0500
Subject: [PATCH 6/8] ntdll: Look up function tables through
 RtlpxLookupFunctionTable on x86_64.

Like Windows 8.1 and later, RtlLookupFunctionTable now makes exactly one
direct call, to the internal RtlpxLookupFunctionTable, which also serves
RtlLookupFunctionEntry. FiveM locates that call by disassembly and hooks
it to supply exception tables for the game image it maps itself;
without a single call it aborts with a fatal error.
---
 dlls/ntdll/tests/unwind.c | 97 +++++++++++++++++++++++++++++++++++++++
 dlls/ntdll/unwind.c       | 92 ++++++++++++++++++++++++++++++++++---
 2 files changed, 182 insertions(+), 7 deletions(-)

diff --git a/dlls/ntdll/tests/unwind.c b/dlls/ntdll/tests/unwind.c
index baf2e9caafc..b8704d6bb20 100644
--- a/dlls/ntdll/tests/unwind.c
+++ b/dlls/ntdll/tests/unwind.c
@@ -4033,6 +4033,100 @@ static void test_dynamic_unwind(void)
     }
 }
 
+
+#if defined(__x86_64__) && !defined(__arm64ec__)
+
+struct function_table_data
+{
+    ULONG_PTR table;
+    ULONG_PTR base;
+    ULONG     image_size;
+    ULONG     size;
+};
+
+static RUNTIME_FUNCTION *hooked_table;
+static ULONG_PTR hooked_start, hooked_end;
+static int hooked_calls;
+
+static void * WINAPI lookup_table_override( ULONG_PTR pc, struct function_table_data *data )
+{
+    hooked_calls++;
+    memset( data, 0, sizeof(*data) );
+    if (pc < hooked_start || pc >= hooked_end) return NULL;
+    data->table = (ULONG_PTR)hooked_table;
+    data->base = hooked_start;
+    data->image_size = hooked_end - hooked_start;
+    data->size = sizeof(*hooked_table);
+    return hooked_table;
+}
+
+/* Applications that map executables themselves (FiveM) find the internal table
+ * lookup as the only direct call in RtlLookupFunctionTable and hook it. */
+static void test_lookup_function_table_hook(void)
+{
+    static const BYTE ret_code[] = {0xc3};
+    static const BYTE unwind_info[] = {1, 0, 0, 0};
+    BYTE *func = (BYTE *)pRtlLookupFunctionTable, *target = NULL, saved[12], patch[12];
+    IMAGE_NT_HEADERS *nt = RtlImageNtHeader( ntdll );
+    ULONG_PTR base, pc, ntdll_end = (ULONG_PTR)ntdll + nt->OptionalHeader.SizeOfImage;
+    RUNTIME_FUNCTION *entry, *rf;
+    DWORD old_prot;
+    int i, calls = 0;
+
+    if (!pRtlLookupFunctionTable || !pRtlLookupFunctionEntry)
+    {
+        win_skip( "RtlLookupFunctionTable not available\n" );
+        return;
+    }
+
+    for (i = 0; i < 64 && func[i] != 0xc3; i++)
+    {
+        BYTE *dest;
+        if (func[i] != 0xe8) continue;
+        dest = func + i + 5 + *(int *)(func + i + 1);
+        if ((ULONG_PTR)dest < (ULONG_PTR)ntdll || (ULONG_PTR)dest >= ntdll_end) continue;
+        target = dest;
+        calls++;
+        i += 4;
+    }
+    ok( calls == 1, "found %u direct calls\n", calls );
+    if (calls != 1) return;
+
+    rf = (RUNTIME_FUNCTION *)((char *)code_mem + 0x2000);
+    memcpy( (char *)code_mem + 0x2100, ret_code, sizeof(ret_code) );
+    memcpy( (char *)code_mem + 0x2200, unwind_info, sizeof(unwind_info) );
+    rf->BeginAddress = 0x2100;
+    rf->EndAddress = 0x2101;
+    rf->UnwindData = 0x2200;
+    hooked_table = rf;
+    hooked_start = (ULONG_PTR)code_mem;
+    hooked_end = hooked_start + 0x3000;
+    hooked_calls = 0;
+    pc = hooked_start + 0x2100;
+
+    /* mov rax, imm64; jmp rax */
+    patch[0] = 0x48; patch[1] = 0xb8;
+    *(void **)(patch + 2) = lookup_table_override;
+    patch[10] = 0xff; patch[11] = 0xe0;
+    memcpy( saved, target, sizeof(saved) );
+    VirtualProtect( target, sizeof(patch), PAGE_EXECUTE_READWRITE, &old_prot );
+    memcpy( target, patch, sizeof(patch) );
+    FlushInstructionCache( GetCurrentProcess(), target, sizeof(patch) );
+
+    base = 0xdeadbeef;
+    entry = pRtlLookupFunctionEntry( pc, &base, NULL );
+
+    memcpy( target, saved, sizeof(saved) );
+    VirtualProtect( target, sizeof(patch), old_prot, &old_prot );
+    FlushInstructionCache( GetCurrentProcess(), target, sizeof(patch) );
+
+    ok( hooked_calls > 0, "override not called\n" );
+    ok( entry == rf, "got entry %p, expected %p\n", entry, rf );
+    ok( base == hooked_start, "got base %Ix, expected %Ix\n", base, hooked_start );
+}
+
+#endif
+
 static void test_exception_directory(void)
 {
     ULONG len, exc_dir_size, old, saved_size, saved_address;
@@ -4110,6 +4204,9 @@ START_TEST(unwind)
 
     test_dynamic_unwind();
     test_exception_directory();
+#if defined(__x86_64__) && !defined(__arm64ec__)
+    test_lookup_function_table_hook();
+#endif
 }
 
 #else  /* !__i386__ */
diff --git a/dlls/ntdll/unwind.c b/dlls/ntdll/unwind.c
index bfffb1ab057..36c4c1672b6 100644
--- a/dlls/ntdll/unwind.c
+++ b/dlls/ntdll/unwind.c
@@ -341,26 +341,104 @@ BOOLEAN CDECL RtlDeleteFunctionTable( RUNTIME_FUNCTION *table )
 }
 
 
-/**********************************************************************
- *              RtlLookupFunctionTable   (NTDLL.@)
+/* FUNCTION_TABLE_DATA filled by RtlpxLookupFunctionTable */
+struct function_table_data
+{
+    ULONG_PTR table;
+    ULONG_PTR base;
+    ULONG     image_size;
+    ULONG     size;
+};
+C_ASSERT( offsetof(struct function_table_data, base) == sizeof(void *) );
+
+void * WINAPI RtlpxLookupFunctionTable( ULONG_PTR pc, struct function_table_data *data );
+
+/***********************************************************************
+ *              RtlpxLookupFunctionTable
+ *
+ * Internal lookup shared by RtlLookupFunctionTable and RtlLookupFunctionEntry.
+ * Applications that map images manually hook it to provide their tables.
  */
-PRUNTIME_FUNCTION WINAPI RtlLookupFunctionTable( ULONG_PTR pc, ULONG_PTR *base, ULONG *len )
+void * DECLSPEC_NOINLINE WINAPI RtlpxLookupFunctionTable( ULONG_PTR pc, struct function_table_data *data )
 {
     LDR_DATA_TABLE_ENTRY *module;
+    ULONG size = 0;
+    void *table;
 
+    memset( data, 0, sizeof(*data) );
     if (LdrFindEntryForAddress( (void *)pc, &module )) return NULL;
-    *base = (ULONG_PTR)module->DllBase;
+    data->base = (ULONG_PTR)module->DllBase;
+    data->image_size = module->SizeOfImage;
 #ifdef __arm64ec__
     if (RtlIsEcCode( pc ))
     {
         IMAGE_ARM64EC_METADATA *metadata = arm64ec_get_module_metadata( module->DllBase );
         if (!metadata) return NULL;
-        *len = metadata->ExtraRFETableSize;
-        return (RUNTIME_FUNCTION *)(*base + metadata->ExtraRFETable);
+        data->size = metadata->ExtraRFETableSize;
+        data->table = data->base + metadata->ExtraRFETable;
+        return (void *)data->table;
     }
 #endif
-    return RtlImageDirectoryEntryToData( module->DllBase, TRUE, IMAGE_DIRECTORY_ENTRY_EXCEPTION, len );
+    table = RtlImageDirectoryEntryToData( module->DllBase, TRUE, IMAGE_DIRECTORY_ENTRY_EXCEPTION, &size );
+    data->table = (ULONG_PTR)table;
+    data->size = size;
+    return table;
+}
+
+
+/**********************************************************************
+ *              RtlLookupFunctionTable   (NTDLL.@)
+ */
+#if defined(__x86_64__) && !defined(__arm64ec__)
+C_ASSERT( offsetof(struct function_table_data, base) == 0x08 );
+C_ASSERT( offsetof(struct function_table_data, size) == 0x14 );
+/* Like on Windows 8.1 and later, this makes exactly one direct call, to
+ * RtlpxLookupFunctionTable; applications locate it by disassembling here. */
+__ASM_GLOBAL_FUNC( RtlLookupFunctionTable,
+                   "pushq %rsi\n\t"
+                   __ASM_SEH(".seh_pushreg %rsi\n\t")
+                   __ASM_CFI(".cfi_adjust_cfa_offset 8\n\t")
+                   __ASM_CFI(".cfi_rel_offset %rsi,0\n\t")
+                   "pushq %rdi\n\t"
+                   __ASM_SEH(".seh_pushreg %rdi\n\t")
+                   __ASM_CFI(".cfi_adjust_cfa_offset 8\n\t")
+                   __ASM_CFI(".cfi_rel_offset %rdi,0\n\t")
+                   "subq $0x48,%rsp\n\t"
+                   __ASM_SEH(".seh_stackalloc 0x48\n\t")
+                   __ASM_SEH(".seh_endprologue\n\t")
+                   __ASM_CFI(".cfi_adjust_cfa_offset 0x48\n\t")
+                   "movq %rdx,%rsi\n\t"           /* base */
+                   "movq %r8,%rdi\n\t"            /* len */
+                   "leaq 0x20(%rsp),%rdx\n\t"     /* struct function_table_data */
+                   "call " __ASM_NAME("RtlpxLookupFunctionTable") "\n\t"
+                   "movq 0x28(%rsp),%rcx\n\t"     /* data.base */
+                   "testq %rcx,%rcx\n\t"          /* outputs untouched without a module */
+                   "jz 1f\n\t"
+                   "movq %rcx,(%rsi)\n\t"
+                   "movl 0x34(%rsp),%ecx\n\t"     /* data.size */
+                   "movl %ecx,(%rdi)\n"
+                   "1:\taddq $0x48,%rsp\n\t"
+                   __ASM_CFI(".cfi_adjust_cfa_offset -0x48\n\t")
+                   "popq %rdi\n\t"
+                   __ASM_CFI(".cfi_adjust_cfa_offset -8\n\t")
+                   __ASM_CFI(".cfi_same_value %rdi\n\t")
+                   "popq %rsi\n\t"
+                   __ASM_CFI(".cfi_adjust_cfa_offset -8\n\t")
+                   __ASM_CFI(".cfi_same_value %rsi\n\t")
+                   "ret\n\t"
+                   "int3" )
+#else
+PRUNTIME_FUNCTION WINAPI RtlLookupFunctionTable( ULONG_PTR pc, ULONG_PTR *base, ULONG *len )
+{
+    struct function_table_data data;
+    void *table = RtlpxLookupFunctionTable( pc, &data );
+
+    if (!data.base) return NULL;
+    *base = data.base;
+    *len = data.size;
+    return table;
 }
+#endif
 
 
 /***********************************************************************
