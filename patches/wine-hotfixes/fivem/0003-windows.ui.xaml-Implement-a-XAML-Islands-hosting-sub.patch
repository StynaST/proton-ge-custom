     test_ColorHelper();
 
     RoUninitialize();
+
+    thread = CreateThread( NULL, 0, hosting_thread, NULL, 0, NULL );
+    WaitForSingleObject( thread, INFINITE );
+    CloseHandle( thread );
 }
